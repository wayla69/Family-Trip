{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bookshelf trip seed",
  "type": "object",
  "required": [
    "slug",
    "title",
    "date_from",
    "date_to",
    "timezone",
    "children",
    "days"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "legacy_trip_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "upcoming",
        "in_progress",
        "done"
      ]
    },
    "title": {
      "$ref": "#/$defs/i18n"
    },
    "date_from": {
      "type": "string",
      "format": "date"
    },
    "date_to": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "type": "string"
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "name_th",
          "name_en"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "name_th": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          },
          "age_at_trip": {
            "$ref": "#/$defs/i18n"
          }
        }
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "date",
          "title"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "emoji": {
            "type": "string"
          },
          "gradient": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "title": {
            "$ref": "#/$defs/i18n"
          },
          "sleep": {
            "$ref": "#/$defs/i18n"
          },
          "moving": { "$ref": "#/$defs/i18n", "description": "how we get around that day (manual's Moving line)" },
          "pick": { "$ref": "#/$defs/i18n", "description": "Local pick" },
          "planB": { "$ref": "#/$defs/i18n" },
          "money": { "$ref": "#/$defs/i18n", "description": "Money today — prices only, never bookings" },
          "plan": {
            "type": "array",
            "description": "the day's timeline; stored in trip_days.plan with the four lines above and tips",
            "items": { "type": "object", "required": ["th", "en"], "properties": { "t": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" }, "th": { "type": "string" }, "en": { "type": "string" } } }
          },
          "tips": { "type": "array", "items": { "$ref": "#/$defs/i18n" } },
          "stay": { "type": "object", "description": "tonight's stay for the driver: name, addr (public address), q (Maps query)" },
          "route": { "type": "string", "format": "uri", "description": "the day's route in Google Maps" },
          "eat": { "type": "array", "description": "more places to eat nearby: [{name, note i18n, pr, q}]" },
          "learn": { "type": "array", "description": "learn-on-the-way cards: [{name, country, facts[], kid}] (i18n); kid lines also feed the passport mission" },
          "quiz": { "type": "array", "description": "[{q, a}] (i18n) — passport mission + kid mode" },
          "planned_places": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string"
                },
                "th": {
                  "type": "string"
                },
                "zh": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "firsts_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          },
          "label": {
            "$ref": "#/$defs/i18n"
          }
        }
      }
    },
    "moods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stamp": {
      "type": "object"
    },
    "cover": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    },
    "info": {
      "type": "object",
      "description": "pocket guide (trips.info): emergency [{label, tel, main}], lost, stays [{base, prop, ci, co, n, why, addr, q}], guide [{title, sub, text}], prices {head, cols, rows}, pack [{group, items}], general [{theme, emo, items[{t, x}]}], wild [{name, emo, text}] — never bookings"
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "properties": {
        "th": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    }
  }
}