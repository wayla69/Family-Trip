# Required
# Family PIN (digits, 6+), or any longer passphrase
FAMILY_CODE=
# Optional: a secret link for grandparents (read-only):  https://YOUR-APP.up.railway.app/v/<VIEW_TOKEN>
VIEW_TOKEN=
# Optional (24+ chars): enables GET /api/backup.zip with "Authorization: Bearer <BACKUP_TOKEN>" for the weekly Backup workflow
BACKUP_TOKEN=
# Optional: signs login cookies; generated once and kept in Postgres if empty
SESSION_SECRET=
# Optional: enables the "Ask Claude to write the story of the day" button
ANTHROPIC_API_KEY=
STORY_MODEL=claude-sonnet-5-5
# Railway sets PORT. DATA_DIR = temp space for restores (+ photos when BUCKET is unset); no volume needed on Railway
DATA_DIR=/data
# Postgres (required in production): Railway reference ${{Postgres.DATABASE_URL}}. PGSSL=1 forces TLS (public proxy URLs).
DATABASE_URL=
# Photo bucket (Railway Storage Bucket references). Unset BUCKET = photos on local disk under DATA_DIR/media.
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
ENDPOINT=
# BUCKET_PATH_STYLE=1   # only if the bucket's Credentials tab says path-style (and for MinIO / s3rver)
