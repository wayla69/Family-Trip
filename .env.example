# Required
# Family PIN (digits, 6+), or any longer passphrase
FAMILY_CODE=
# Optional: a secret link for grandparents (read-only):  https://YOUR-APP.up.railway.app/v/<VIEW_TOKEN>
VIEW_TOKEN=
# Optional: relatives' view-only PIN (digits, 6+, different from FAMILY_CODE) — same PIN pad, read-only session
VIEW_PIN=
# Optional (24+ chars): enables GET /api/backup.zip with "Authorization: Bearer <BACKUP_TOKEN>" for the weekly Backup workflow
BACKUP_TOKEN=
# Optional: signs login cookies; generated once and kept in Postgres if empty
SESSION_SECRET=
# Optional: enables the "Ask Claude to write the story of the day" button
ANTHROPIC_API_KEY=
STORY_MODEL=claude-sonnet-5-5
# stories Claude may write per day for the whole family (default 30) — keeps the API bill bounded
STORY_DAILY=60
# Optional: the models behind "a book from a PDF" (#/import): the structure (default claude-haiku-5-5) and the kids' pages + Thai (default STORY_MODEL)
# IMPORT_EXTRACT_MODEL=claude-haiku-5-5
# IMPORT_WRITE_MODEL=claude-sonnet-5-5
# Optional: live forecast on the Today page from Open-Meteo (free, no key). The server sends only each stay's town-level
# coordinates from the seed. WX_BASE_URL points the tests at a mock; WX_HORIZON_DAYS (default 16) is how far ahead it asks.
# WX_BASE_URL=https://api.open-meteo.com
# Optional: trip reminders (Web Push, 30 min before each timed step). Keys are generated once and kept in Postgres if empty;
# PUSH_LEAD_MIN changes the lead (default 30); PUSH_SUBJECT is a mailto: the push services may use to reach the owner.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_LEAD_MIN=30
PUSH_SUBJECT=
# Railway sets PORT. DATA_DIR = temp space for restores (+ photos when BUCKET is unset); no volume needed on Railway
DATA_DIR=/data
# Postgres (required in production): Railway reference ${{Postgres.DATABASE_URL}}. PGSSL=1 forces TLS (public proxy URLs).
DATABASE_URL=
# Photo bucket (Railway Storage Bucket references). Unset BUCKET = photos on local disk under DATA_DIR/media.
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
ENDPOINT=
# BUCKET_PATH_STYLE=1   # only if the bucket's Credentials tab says path-style (and for MinIO / s3rver)
# Another family's instance: 0 = start empty (no Mimi and Mika, no bundled Hong Kong / Australia book) — they set up their family at #/family
# BUNDLED_SEEDS=0
# Optional: each child's own cartoon character, drawn by OpenAI's image model from one photo the parents upload at #/family.
# The photo is shrunk and sent once; only the drawing is kept (family-only, never on the sign-in page). Without the key the button is off.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium        # low | medium | high
# AVATAR_YEARLY=3                    # drawings per child per 12 months (a refused or failed try is not counted)
